# =====================================================
# Military Asset Management System — Backend Config
# =====================================================

# Server
PORT=5000
NODE_ENV=development

# Database (PostgreSQL)
# Local dev: use your Neon/Supabase connection string
# Production: set this to the production DB connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# CORS
CLIENT_URL=http://localhost:5173
